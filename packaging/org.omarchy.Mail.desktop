[Desktop Entry]
Type=Application
Version=1.0
Name=Omarchy Mail
GenericName=Email Client
Comment=A calm, native email client for Omarchy
Exec=omarchy-mail %U
TryExec=omarchy-mail
Icon=org.omarchy.Mail
Terminal=false
Categories=Network;Email;GTK;
MimeType=x-scheme-handler/mailto;message/rfc822;
StartupNotify=true
StartupWMClass=org.omarchy.Mail
Keywords=email;mail;imap;smtp;

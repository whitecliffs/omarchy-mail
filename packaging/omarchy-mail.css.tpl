/* Generated from the active Omarchy theme into the staged theme directory. */
@define-color om-background {{ background }};
@define-color om-dark-background {{ dark_background }};
@define-color om-darker-background {{ darker_background }};
@define-color om-lighter-background {{ lighter_background }};
@define-color om-foreground {{ foreground }};
@define-color om-light-foreground {{ light_foreground }};
@define-color om-muted {{ muted }};
@define-color om-accent {{ accent }};
@define-color om-selection {{ selection }};
@define-color om-red {{ red }};
@define-color om-yellow {{ yellow }};
@define-color om-green {{ green }};
@define-color om-blue {{ blue }};
@define-color om-cyan {{ cyan }};
